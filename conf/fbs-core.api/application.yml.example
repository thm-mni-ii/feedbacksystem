sso:
  # Variant 1: the reverse proxy or SAML service provider already protects
  # /api/v1/login/sso and forwards the authenticated user via one of these headers.
  login-url: ""
  return-url-parameter: ""
  principal-header-names: X-Forwarded-User,eppn,Remote-User,SM_USER

  # After successful SSO, the backend redirects here and the Angular login page
  # stores the JWT from the cookie and continues to the requested route.
  success-url: /login
  failure-url: /login?ssoError=1

ldap:
  # Keep LDAP enabled if external SSO users should be provisioned automatically
  # when they are not yet present in the local database.
  enabled: true
  allowLogin: false
  baseDn: dc=fh-giessen-friedberg,dc=de
  url: ldaps://ldap.fh-giessen.de
  filter: (uid={user})
  attributeNames:
    uid: uid
    sn: sn
    name: givenName
    mail: mail

# Variant 2: uncomment these values if the backend should actively redirect the
# browser to a login endpoint of the SAML service provider.
# sso:
#   login-url: https://idp.example.org/Shibboleth.sso/Login
#   return-url-parameter: target
#   principal-header-names: X-Forwarded-User,eppn,Remote-User,SM_USER
#   success-url: /login
#   failure-url: /login?ssoError=1
