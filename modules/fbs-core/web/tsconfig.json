{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "es2015",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "target": "es2020",
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2017",
      "dom"
    ],
    "skipLibCheck": true
  },
  "exclude": [
    "src/app/model/wrongTables.ts",
    "src/app/util/css.ts",
    "src/environments/environment.prod.ts",
    "src/environments/environment.ts"
  ]
}