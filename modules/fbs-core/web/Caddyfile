:80 {
    root * /usr/share/caddy

    # Frame embedding security headers - allow embedding across any HTTP/HTTPS origin
    header {
        Content-Security-Policy "frame-ancestors 'self' http: https:;"
        X-Frame-Options "ALLOWALL"
        -Server
    }

    # Normalize trailing slash for base href resolution
    handle /course-management {
        redir /course-management/ 301
    }

    # Proxy /api to the Course Management API backend
    handle /api/* {
        reverse_proxy {$FBS_CORE_URL:https://core:443} {
            transport http {
                tls_insecure_skip_verify
            }
        }
    }

    # Cache-busted hashed assets (JS/CSS with content hash in filename, fonts, icons)
    @static {
        path *.js *.css *.woff *.woff2 *.ttf *.eot *.svg *.ico *.png *.jpg *.jpeg *.webp
        path /course-management/*.js /course-management/*.css /course-management/*.woff /course-management/*.woff2 /course-management/*.ttf /course-management/*.eot /course-management/*.svg /course-management/*.ico /course-management/*.png /course-management/*.jpg /course-management/*.jpeg /course-management/*.webp
    }
    header @static {
        Cache-Control "public, max-age=31536000, immutable"
    }

    @html {
        path /index.html
    }
    header @html {
        Cache-Control "no-store, no-cache, must-revalidate"
    }

    # Angular SPA routes prefixed with /course-management/
    handle_path /course-management/* {
        try_files {path} {path}/ /index.html
        file_server
    }

    # Angular SPA fallback for direct root access
    handle {
        try_files {path} {path}/ /index.html
        file_server
    }
}
