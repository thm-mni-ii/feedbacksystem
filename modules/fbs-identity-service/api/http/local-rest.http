### Health
GET http://localhost:8080/health


### Manifest
GET http://localhost:8080/manifest


### OpenAPI JSON
GET http://localhost:8080/openapi


### Local login - success
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "username": "maxlogin",
  "password": "test123"
}

> {% client.global.set("accessToken", response.body.accessToken); %}


### Local login - wrong password
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "username": "maxlogin",
  "password": "wrong"
}


### Local login - unknown user
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "username": "unknownuser",
  "password": "test123"
}


### Local login with blank username - bad request
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "username": "",
  "password": "test123"
}


### Local login with malformed body - bad request
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "username":
}


### Local login - admin
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "username": "admintest",
  "password": "admin123"
}

> {% client.global.set("adminToken", response.body.accessToken); %}

### Local login - managed test user
# Before running this request:
# Run "Create managed test user - admin success" in local-graphql.http first.
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "username": "{{managedUsername}}",
  "password": "okangenc123"
}

> {% client.global.set("managedUserToken", response.body.accessToken); %}

### SAML login redirect - disabled
GET http://localhost:8080/api/v1/login/sso


### Legal text - impressum
GET http://localhost:8080/api/v1/legal/impressum


### Legal text - privacy text
GET http://localhost:8080/api/v1/legal/privacy-text


### Legal text - not found
GET http://localhost:8080/api/v1/legal/unknown


### Get terms-of-use status without token - unauthorized
GET http://localhost:8080/api/v1/legal/termsofuse/status


### Accept terms of use without token - unauthorized
PUT http://localhost:8080/api/v1/legal/termsofuse/accept


### Get current user's terms-of-use status - success
# First run "Local login - managed test user" in this file to set {{managedUserToken}}.
GET http://localhost:8080/api/v1/legal/termsofuse/status
Authorization: Bearer {{managedUserToken}}


### Accept terms of use for current user - success
PUT http://localhost:8080/api/v1/legal/termsofuse/accept
Authorization: Bearer {{managedUserToken}}


### Get current user's terms-of-use status after acceptance - success
GET http://localhost:8080/api/v1/legal/termsofuse/status
Authorization: Bearer {{managedUserToken}}


### Login managed user with changed password
# Before running this request:
# Run "Change user password - admin success" in local-graphql.http first.
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "username": "okangenc2",
  "password": "changedByAdmin123"
}
