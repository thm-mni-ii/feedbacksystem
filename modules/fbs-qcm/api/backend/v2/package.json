{
  "name": "backend-v2",
  "version": "1.0.0",
  "description": "QCM Backend v2 (rewrite)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn -r dotenv/config src/index.ts",
    "build": "tsc",
    "start": "npm run build && node --env-file=.env dist/index.js",
    "test": "jest --runInBand",
    "seed": "tsx --tsconfig tsconfig.seed.json --env-file=.env src/seed/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.2.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.3"
  }
}
